# ─────────────────────────────────────────────────────────────
# SOLARPRO 360 — variables de entorno (copiar a .env y completar)
# Nunca subir .env al repositorio.
# ─────────────────────────────────────────────────────────────

# Conexión de la API con un rol SIN privilegios de superusuario (RLS activo).
# En Supabase: crear el rol "solarpro_app" con la migración 0000 y usar su cadena de conexión.
DATABASE_URL=postgres://solarpro_app:CHANGE_ME@localhost:5432/solarpro360

# Conexión administrativa SOLO para migraciones y seeds (no la usa la API en ejecución).
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/solarpro360

# Verificación de tokens emitidos por Supabase Auth.
# Opción A (HS256): secreto JWT del proyecto Supabase.
SUPABASE_JWT_SECRET=
# Opción B (asimétrico): URL JWKS del proyecto (tiene prioridad si está definida).
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
