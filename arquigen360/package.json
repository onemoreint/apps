{
  "name": "arquigen-360",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "verify:bundle": "node scripts/verify-bundle.mjs dist/index.html",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:bundle",
    "publish:app": "npm run check && node scripts/verify-bundle.mjs dist/index.html --copy",
    "preview": "vite preview"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
