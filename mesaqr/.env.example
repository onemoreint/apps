# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API).
#
# Solo van aquí valores PÚBLICOS. La clave "anon" es pública por diseño:
# la seguridad la ponen las políticas RLS de la base de datos.
# NUNCA coloques aquí la clave service_role.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
