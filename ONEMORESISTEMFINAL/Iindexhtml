async function askFunnel(day) {
  const titles = {1:'Mensaje Día 1 — Primer Contacto',2:'Mensaje Día 2 — Historia de Resultado',3:'Mensaje Día 3 — Educación del Producto',4:'Mensaje Día 4 — Presentar la Oportunidad',5:'Mensaje Día 5 — Manejo de Objeciones',6:'Mensaje Día 6 — Urgencia y Escasez',7:'Mensaje Día 7 — Cierre y Onboarding'};
  const prompts = {
    1:'Escribe el mensaje de WhatsApp del Día 1 del funnel ONE MORE: primer contacto que genere curiosidad sin vender directamente. Tono amigable, natural. Máximo 120 palabras.',
    2:'Escribe el mensaje de WhatsApp del Día 2: compartir una historia de transformación con el producto One More. Testimonial que genera credibilidad. Máximo 130 palabras.',
    3:'Escribe el mensaje de WhatsApp del Día 3: educar sobre la tecnología transdérmica de One More de forma simple y atractiva. Sin tecnicismos. Máximo 120 palabras.',
    4:'Escribe el mensaje de WhatsApp del Día 4: presentar la oportunidad de negocio One More e invitar a un Zoom o video. Enfocado en libertad financiera. Máximo 130 palabras.',
    5:'Escribe el mensaje de WhatsApp del Día 5: manejar las objeciones más comunes (caro, no tengo tiempo, es pirámide). Respuestas claras y empáticas. Máximo 140 palabras.',
    6:'Escribe el mensaje de WhatsApp del Día 6: crear urgencia ética y cierre suave. Escasez real, beneficio claro, llamada a la acción. Máximo 120 palabras.',
    7:'Escribe el mensaje de WhatsApp del Día 7: mensaje de cierre final, inscripción y bienvenida al equipo One More. Celebración y próximos pasos. Máximo 130 palabras.'
  };
  const resultDiv = document.getElementById('funnel-result');
  const titleEl = document.getElementById('funnel-result-title');
  const contentEl = document.getElementById('funnel-result-content');
  titleEl.textContent = titles[day];
  contentEl.textContent = 'Generando mensaje...';
  resultDiv.style.display = 'block';
  resultDiv.scrollIntoView({behavior:'smooth',block:'nearest'});
  try {
    const reply = await callClaude(prompts[day], 'Eres experto en funnels de WhatsApp para network marketing ONE MORE. Escribe mensajes naturales, conversacionales y efectivos.');
    contentEl.textContent = reply;
  } catch(e) {
    contentEl.textContent = 'Error al generar el mensaje.';
  }
}

const pages = {'dashboard':'Hub Central IA','mentor':'IA Mentor','viral':'Viral Machine','funnel':'Funnel WhatsApp','training':'Training Center','biblioteca':'Biblioteca Wellness'};
const subs = {'dashboard':'Dashboard operativo ONE MORE','mentor':'Consultor experto en producto y negocio','viral':'Generador de contenido que convierte','funnel':'Secuencia de 7 días de conversión','training':'Onboarding y duplicación de equipo','biblioteca':'Vademécum y protocolos ONE MORE'};

function navigateTo(page) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.getElementById('page-'+page).classList.add('active');
  document.querySelector('[data-page="'+page+'"]')?.classList.add('active');
  document.getElementById('topbar-title').textContent = pages[page];
  document.getElementById('topbar-sub').textContent = subs[page];
}

document.querySelectorAll('.nav-item[data-page]').forEach(item => {
  item.addEventListener('click', () => navigateTo(item.dataset.page));
});
document.querySelectorAll('.module-card[data-nav]').forEach(card => {
  card.addEventListener('click', () => navigateTo(card.dataset.nav));
});
</script>
