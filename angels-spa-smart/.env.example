# Copia este archivo como .env.local (nunca subas .env* reales al repositorio).

# demo = datos ficticios en el navegador (por defecto) · production = Supabase
VITE_APP_MODE=demo

# Fase 3 (requiere autorización): proyecto de Supabase.
# La "anon key" es pública por diseño; la seguridad la dan las políticas RLS.
# ⚠️ NUNCA pongas aquí la service_role key: no debe existir en el frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
