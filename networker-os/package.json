{
  "name": "networker-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "verify:bundle": "node scripts/verify-bundle.mjs dist/index.html",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:bundle",
    "publish:app": "npm run check && node scripts/verify-bundle.mjs dist/index.html --copy",
    "preview": "vite preview"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "^3.1.1",
    "fake-indexeddb": "^6.2.5",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2",
    "world-atlas": "^2.0.2"
  }
}
