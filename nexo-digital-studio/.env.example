# ─── NEXO DIGITAL STUDIO · variables de entorno ───
# Copia este archivo como .env.local y personaliza. Las variables VITE_* son PÚBLICAS
# (se incrustan en el navegador). Nunca pongas claves secretas con prefijo VITE_.

# WhatsApp de la agencia: solo dígitos, con código de país (ej. 573001234567)
VITE_WHATSAPP_NUMBER=573126387467

# URL pública final del sitio (para canonical/OG en build). Ej: https://nexodigital.studio
VITE_SITE_URL=https://onemoreint.github.io/apps/nexo/

# Endpoint del backend de IA (opcional). Si está vacío, NEXO AI usa el motor de reglas local.
# Con Netlify: /.netlify/functions/nexo-ai
VITE_AI_ENDPOINT=

# ─── SOLO BACKEND (Netlify/Vercel → variables del panel, NUNCA en el frontend) ───
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-4-5
# ALLOWED_ORIGIN=https://tudominio.com
