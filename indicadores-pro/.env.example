# INDICADORES PRO — variables de entorno
# Copia este archivo como .env.local y completa los valores.
# Si dejas las dos variables de Supabase vacías, la app funciona en MODO LOCAL:
# los datos se guardan solo en este navegador (ideal para demo y pruebas).

# URL del proyecto Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# Clave pública "anon" (Project Settings → API). Es pública por diseño;
# la seguridad la ponen las políticas RLS de la base de datos.
VITE_SUPABASE_ANON_KEY=

# Nombre comercial de la app (opcional; por defecto INDICADORES PRO)
VITE_APP_NAME=

# NUNCA pongas aquí la service_role key ni claves de IA:
# esas viven solo como secretos de las Edge Functions de Supabase.
