# Copia este archivo como .env.local para desarrollar contra Supabase.
# Sin estas variables la tienda funciona en modo demostración (catálogo local, sin panel).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave PUBLICABLE (sb_publishable_… o anon). Nunca pongas aquí la service_role.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Tienda que abre el enlace sin ?tienda=
VITE_TIENDA=dulce-pedido-demo
