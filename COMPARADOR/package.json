{
  "name": "pricematch-ai",
  "version": "2.0.0",
  "description": "PriceMatch AI - Encuentra exactamente el mismo producto al mejor precio en SHEIN, AliExpress y Temu",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test backend/**/*.test.js",
    "test:watch": "node --test --watch backend/**/*.test.js",
    "lint": "eslint backend/",
    "format": "prettier --write backend/"
  },
  "keywords": [
    "price-comparison",
    "product-matching",
    "shein",
    "aliexpress",
    "temu",
    "ecommerce"
  ],
  "author": "José Lugo",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
