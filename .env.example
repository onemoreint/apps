# OptiConsulta — variables de entorno de ejemplo. NO incluye secretos reales.
# Copia este archivo a .env.local y completa los valores.

# --- Públicas (llegan al navegador) ---
# URL del proyecto Supabase. En local: la que imprime `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon/publishable). Solo permite lo que autoricen las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo servidor (NUNCA prefijar con NEXT_PUBLIC_) ---
# Clave service_role: omite RLS. Solo para scripts administrativos y siembra de demo.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app, usada en enlaces de recuperación de contraseña.
APP_BASE_URL=http://localhost:3000
# Zona horaria por defecto para organizaciones nuevas.
DEFAULT_TIMEZONE=America/Bogota

# --- Pruebas de base de datos (opcional) ---
# Base PostgreSQL desechable para `npm run test:db`. Se BORRA y recrea en cada ejecución.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/opticonsulta_test
