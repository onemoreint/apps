<script>
const SYSTEM_PROMPT = `Eres el asistente de IA oficial del sistema ONE MORE AI SYSTEM, desarrollado para José Lugo, distribuidor experto y speaker de la empresa ONE MORE International. ONE MORE es una compañía de network marketing enfocada en productos de bienestar de entrega transdérmica (parches). 

Tu personalidad: experto, motivador, profesional, conciso. Hablas siempre en español colombiano. Conoces a fondo:
- Los productos transdérmicos ONE MORE y su tecnología
- El plan de compensación: rangos Gold, Platinum, Diamond, Royal Diamond, con bonos de hasta 4 niveles de matching
- El Bono 2+1 y estrategias de duplicación
- Funnels de WhatsApp, scripts de invitación y cierre
- Creación de contenido viral para redes sociales (TikTok, Instagram, Facebook)
- Capacitación de equipos y onboarding de nuevos socios
- Estrategias de escalamiento de red en LATAM

Contacto de distribución: +57 312 638 7467 (José Lugo, Antioquia, Colombia)

Responde siempre de forma estructurada, práctica y accionable. Máximo 300 palabras por respuesta. Usa emojis con moderación para hacer el contenido más dinámico.`;

async function callClaude(userMsg, systemSuffix) {
  const sys = systemSuffix ? SYSTEM_PROMPT + '\n\n' + systemSuffix : SYSTEM_PROMPT;
  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 1000,
      system: sys,
      messages: [{role: 'user', content: userMsg}]
    })
  });
  const data = await res.json();
  return data.content?.[0]?.text || 'Error al conectar con la IA.';
}

function addMsg(containerId, role, text) {
  const c = document.getElementById(containerId);
  const d = document.createElement('div');
  d.className = 'msg msg-' + role;
  const name = document.createElement('span');
  name.className = 'msg-name';
  name.textContent = role === 'ia' ? 'ONE MORE IA' : 'Tú';
  const bubble = document.createElement('div');
  bubble.className = 'msg-bubble';
  bubble.textContent = text;
  d.appendChild(name);
  d.appendChild(bubble);
  c.appendChild(d);
  c.scrollTop = c.scrollHeight;
}

function addTyping(containerId) {
  const c = document.getElementById(containerId);
  const d = document.createElement('div');
  d.className = 'msg msg-ia';
  d.id = 'typing-' + containerId;
  const t = document.createElement('div');
  t.className = 'typing';
  t.innerHTML = '<span></span><span></span><span></span>';
  d.appendChild(t);
  c.appendChild(d);
  c.scrollTop = c.scrollHeight;
  return d;
}

function removeTyping(containerId) {
  const el = document.getElementById('typing-' + containerId);
  if(el) el.remove();
}

async function chat(inputId, msgContainerId, systemSuffix) {
  const input = document.getElementById(inputId);
  const msg = input.value.trim();
  if(!msg) return;
  input.value = '';
  addMsg(msgContainerId, 'user', msg);
  const typing = addTyping(msgContainerId);
  try {
    const reply = await callClaude(msg, systemSuffix);
    removeTyping(msgContainerId);
    addMsg(msgContainerId, 'ia', reply);
  } catch(e) {
    removeTyping(msgContainerId);
    addMsg(msgContainerId, 'ia', 'Hubo un error al conectar con la IA. Verifica tu conexión.');
  }
}

async function quickAsk(msgContainerId, msg, systemSuffix) {
  addMsg(msgContainerId, 'user', msg);
  const typing = addTyping(msgContainerId);
  try {
    const reply = await callClaude(msg, systemSuffix);
    removeTyping(msgContainerId);
    addMsg(msgContainerId, 'ia', reply);
  } catch(e) {
    removeTyping(msgContainerId);
    addMsg(msgContainerId, 'ia', 'Error de conexión.');
  }
}

